{
  "name": "word-store-host",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NEXT_PRIVATE_LOCAL_WEBPACK=true next dev -p 3100",
    "build": "cross-env NEXT_PRIVATE_LOCAL_WEBPACK=true next build",
    "build:cloudflare": "cross-env NEXT_PRIVATE_LOCAL_WEBPACK=true CLOUDFLARE_STATIC_EXPORT=true PRODUCTS_REMOTE_URL=https://module-federation-store-products.berqtguzel.workers.dev BASKET_REMOTE_URL=https://module-federation-store-basket.berqtguzel.workers.dev next build",
    "deploy": "npm run build:cloudflare && wrangler deploy",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@module-federation/nextjs-mf": "8.9.0",
    "next": "15.5.29",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "webpack": "5.101.3"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.5",
    "cross-env": "7.0.3",
    "typescript": "5.9.3",
    "wrangler": "^4.163.0"
  },
  "overrides": {
    "enhanced-resolve": "5.18.3",
    "postcss": "8.5.23"
  }
}
