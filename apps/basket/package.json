{
  "name": "word-store-basket",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "webpack serve --mode development --port 3102",
    "build": "webpack --mode production && node scripts/write-cloudflare-headers.mjs",
    "deploy": "npm run build && wrangler deploy",
    "start": "serve -s dist -l 3102",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "antd": "5.29.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.5",
    "css-loader": "7.1.2",
    "html-webpack-plugin": "5.6.4",
    "serve": "14.2.8",
    "style-loader": "4.0.0",
    "ts-loader": "9.5.4",
    "typescript": "5.9.3",
    "webpack": "5.101.3",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.2",
    "wrangler": "^4.163.0"
  }
}
